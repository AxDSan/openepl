# A web service. `main` prints one line and returns; the program stays alive
# because the server is a live event source, and it serves until something
# calls `quit`.
module __MODULE__
use net

httpserver site
  port = 8080
  on request: on_request
end

# The compiler calls an event handler with no arguments, so this one asks for
# the request being dispatched and passes it on. Everything below takes the
# request as a parameter — a request kept in a module variable would answer the
# first caller correctly and quietly hand the second caller the first's data.
sub on_request
  call route(net_request())
end

sub route(req: int)
  let path: text = net_req_path(req)
  if path = "/"
    call net_req_reply(req, 200, concat("hello from __MODULE__, via ", net_req_method(req)))
  else
    call net_req_reply(req, 404, concat("no route for ", path))
  end
end

sub main
  # 127.0.0.1 is the default and this program does not change it: the server is
  # reachable from this machine only. `bind = "0.0.0.0"` opens it to the
  # network, which is worth being deliberate about.
  call print_text("serving on http://127.0.0.1:8080")
end
