# A console program that keeps running after `main` returns.
#
# `main` prints one line and returns — and the program stays alive, because the
# timer is a live event source and the runtime's loop stays in it until
# something calls `quit`. A timer has no rectangle, so it is declared here at
# module level rather than inside a form: a program that waits for something
# needs no window at all.
module __MODULE__
target console

var remaining: int = 3

timer countdown
  interval = 500
  on tick: on_tick
end

sub main
  call print_text(banner(remaining))
end

sub on_tick
  remaining = remaining - 1
  call print_text(banner(remaining))
  if remaining <= 0
    call quit()
  end
end

# A subroutine with a parameter and a return value. Subroutines can be called
# from anywhere, including from a line above this one.
sub banner(n: int): text
  if n > 0
    return concat(int_to_text(n), "...")
  end
  return "Liftoff."
end
