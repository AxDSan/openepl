# OpenEPL Phase 0 vertical slice: print + arithmetic.
# Build:  openepl build examples/hello.oir -o hello
# Run:    ./hello
module hello

sub main
  let title: text = "OpenEPL — arithmetic demo"
  call print_text(title)

  # 6 * 7, and operator precedence: 2 + 3 * 4 == 14
  let answer: int = 6 * 7
  call print_int(answer)
  call print_int(2 + 3 * 4)
  call print_int(100 - 58)
  call print_int(84 / 2)
end
