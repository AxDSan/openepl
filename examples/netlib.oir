# Networking: TCP and plain HTTP, with no TLS anywhere.
#
#   openepl run examples/netlib.oir
#
# Nothing here needs the network to be up: the URL commands are pure, and the
# two failures it demonstrates — an https url and a dead host — are exactly the
# ones a program must be able to detect.
module netlib
use net

sub main
  # --- percent-encoding round-trips ---
  let raw: text = "name=Ada Lovelace & co/100%"
  let enc: text = net_url_encode(raw)
  call print_text(enc)
  call print_text(net_url_decode(enc))
  if net_url_decode(enc) = raw
    call print_text("round-trip ok")
  end

  # --- https fails loudly; it is never downgraded to http ---
  let body: text = net_http_get("https://example.com/")
  if last_error_code() = 10006
    call print_text("https refused: unsupported")
    call print_text(last_error_text())
  else
    call print_text("BUG: https should not have been accepted")
  end

  # --- a scheme that is not http at all ---
  call print_text(net_http_get("ftp://example.com/x"))
  call print_int(last_error_code())

  # --- a connection that cannot succeed: nothing listens on this port ---
  call print_int(net_timeout_get())
  if net_timeout_set(1500)
    call print_int(net_timeout_get())
  end
  let h: int = net_tcp_connect("127.0.0.1", 9)
  if h = 0
    call print_text("connect failed as expected")
    call print_text(last_error_text())
  else
    call print_text("unexpectedly connected")
    if net_tcp_close(h)
      call print_text("closed")
    end
  end

  # --- a name that does not resolve ---
  call print_text(net_host_ip("no-such-host.invalid"))
  if last_error_code() <> 0
    call print_text("resolver failure reported")
  end

  # --- localhost always resolves, without touching the network ---
  call print_text(net_host_ip("127.0.0.1"))

  # --- the serving side, with nothing served ---
  # net_request() answers only inside an httpserver `request` handler; asking
  # for one anywhere else is a failure, not an empty answer, because a program
  # that got 0 back and carried on would be replying into nothing.
  call print_int(net_request())
  if last_error_code() = 10005
    call print_text("no request outside a handler, as expected")
  end
  # And a handle that is not a request is refused rather than read.
  call print_text(net_req_path(0))
  call print_int(last_error_code())

  # --- a stale handle is detected, not dereferenced ---
  call print_int(net_tcp_close_all())
  if net_tcp_close(1)
    call print_text("BUG: closed a handle that was never open")
  else
    call print_text("stale handle refused")
    call print_int(last_error_code())
  end
end
