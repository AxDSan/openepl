# Running other programs: libs/process.
#
# The distinction the library is built around is "could not start" (-1 or
# handle 0, with an error code) versus "ran and failed" (its real exit status,
# no error).
module processlib
use process

sub main
  # --- run something and look at how it ended ---
  let ok: int = process_run("true")
  call print_text(concat("true -> ", int_to_text(ok)))

  let bad: int = process_run("exit 3")
  call print_text(concat("exit 3 -> ", int_to_text(bad)))
  call print_text(concat("  error code ", int_to_text(last_error_code())))

  let missing: int = process_run("/nonexistent/program")
  call print_text(concat("missing -> ", int_to_text(missing)))
  if last_error_code() <> 0
    call print_text("  it could not start, and said so")
  end

  # --- capture what it said ---
  call print_text(trim(process_run_capture("echo captured output")))

  # --- a child kept alive, talked to line by line ---
  var h: int = process_start("while read line; do echo \"got: $line\"; done")
  if h = 0
    call print_text("could not start the child")
  else
    call print_text("started")
    if process_write_line(h, "one")
      call print_text(process_read_line(h))
    end
    if process_write_line(h, "two")
      call print_text(process_read_line(h))
    end
    if process_is_running(h)
      call print_text("still running")
    end
    let status: int = process_wait(h)
    call print_text(concat("child exit -> ", int_to_text(status)))
    if process_is_running(h)
      call print_text("BUG: still running after wait")
    else
      call print_text("finished")
    end
    if process_close(h)
      call print_text("closed")
    end
  end

  # --- reading to the end: "" is ambiguous, so the predicate sits beside it ---
  var lines: int = process_start("printf 'alpha\\nbeta\\n\\ngamma\\n'")
  var count: int = 0
  while count < 10
    let line: text = process_read_line(lines)
    if process_at_end(lines)
      count = 10
    else
      call print_text(concat("line: [", concat(line, "]")))
      count = count + 1
    end
  end
  call print_text("end of output")
  if process_close(lines)
    call print_text("reader closed")
  end

  # --- a child that outlives its usefulness ---
  let sleeper: int = process_start("sleep 30")
  if process_is_running(sleeper)
    call print_text("sleeper is running")
  end
  if process_kill(sleeper)
    call print_text("sleeper killed")
  end
  call print_int(process_close_all())
end
