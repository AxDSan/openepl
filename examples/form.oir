# Phase 2 RAD half: a form with a button and an event handler, authored in IR.
# The designer will emit exactly this shape (PRD §4.5 / D9 / D11).
#
#   openepl run examples/form.oir
module hello_form
use ui

form main_window
  title = "OpenEPL — Phase 2"
  width = 480
  height = 300
  background_color = "#1e2233"

  label greeting
    text = "Click the button."
    left = 40
    top = 50
    width = 400
    color = "#ffffff"
  end

  button ok_button
    text = "Click me"
    left = 150
    top = 130
    width = 160
    height = 44
    background_color = "#4a86e8"
    border_radius = 8
    on click: on_ok_click
  end
end

# The click handler is an ordinary subroutine — bound by function pointer, so
# its name never reaches the shipped binary (G8).
sub on_ok_click
  call print_text("button clicked!")
end
