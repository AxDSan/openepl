# Records: a name for a group of related values, and the way a subroutine
# gives back more than one thing.
module records

record point
  x: int
  y: int
end

record person
  name: text
  age: int
  home: point
end

# Two values out of one call — the reason records exist at the language level
# rather than as a library.
sub midpoint(a: point, b: point): point
  return point(x: (a.x + b.x) / 2, y: (a.y + b.y) / 2)
end

sub describe(p: person): text
  let where: text = int_to_text(p.home.x) + "," + int_to_text(p.home.y)
  return p.name + " (" + int_to_text(p.age) + ") at " + where
end

sub main
  let a: point = point(x: 0, y: 10)
  let b: point = point(x: 8, y: 20)
  let m: point = midpoint(a, b)
  call print_text(concat("midpoint x=", int_to_text(m.x)))
  call print_text(concat("midpoint y=", int_to_text(m.y)))

  let ada: person = person(name: "Ada", age: 36, home: point(x: 1, y: 2))
  call print_text(describe(ada))

  # A record is a reference, exactly as a list is: `same` and `ada` are two
  # names for one person, so a birthday is seen through both.
  let same: person = ada
  same.age = 37
  call print_text(describe(ada))

  # A list of records is a list like any other: the element is the same
  # pointer a name holds, so `people[i]` and `ada` can be the same person.
  var people: person[] = [ada]
  people = append(people, person(name: "Grace", age: 45, home: point(x: 3, y: 4)))
  for i = 1 to count(people)
    call print_text(concat("  ", describe(people[i])))
  end
end
