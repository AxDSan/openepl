# Arrays and byte-sets: the types that hold more than one value.
#
#   openepl run examples/arrays.oir
#
# The lines here are checks: each prints `ok` or `FAIL`, so running the file is
# the test.
module arrays

# State that outlives one call has to live somewhere, and until arrays existed
# there was nothing here that could hold more than one thing.
var log: text[] = []

# `check` is how every line below reports; a message would otherwise have to be
# repeated in both branches.
sub check(what: text, ok: bool)
  if ok
    call print_text(what + ": ok")
  else
    call print_text(what + ": FAIL")
  end
end

# An array crosses a call boundary as one pointer, so passing and returning one
# costs no more than passing a number.
sub squares(n: int): int[]
  var out: int[] = []
  for i = 1 to n
    out = append(out, i * i)
  end
  return out
end

sub total(xs: int[]): int
  var sum: int = 0
  for i = 0 to count(xs) - 1
    sum = sum + xs[i]
  end
  return sum
end

sub main
  # --- making one ------------------------------------------------------
  # `[]` takes its element type from the declaration, which is the only place
  # an empty list can get one.
  var numbers: int[] = [3, 1, 2]
  var nothing: text[] = []
  call check("count", count(numbers) = 3)
  call check("count of an empty list", count(nothing) = 0)

  # --- reading and writing one element ---------------------------------
  call check("index", numbers[1] = 1)
  numbers[1] = 8
  call check("assign to an element", numbers[1] = 8)

  # --- growing and shrinking -------------------------------------------
  # `append` hands back a NEW array rather than growing this one in place, so
  # any other name still holding the old one keeps working. That is why the
  # result has to be assigned back.
  numbers = append(numbers, 5)
  call check("append", count(numbers) = 4)
  # `remove` shortens in place — shrinking never has to move anything — so it
  # is a statement and not a value.
  call remove(numbers, 0)
  call check("remove", count(numbers) = 3)

  # --- searching and ordering ------------------------------------------
  call check("contains", contains(numbers, 5))
  call check("contains says no", not contains(numbers, 999))
  call check("index_of", index_of(numbers, 5) = 2)
  call check("index_of when absent", index_of(numbers, 999) = -1)
  call sort(numbers)
  call check("sort", join(numbers, ",") = "2,5,8")

  # --- text in, list out, text again ------------------------------------
  let fields: text[] = split("alpha,beta,gamma", ",")
  call check("split", count(fields) = 3)
  call check("split keeps order", fields[2] = "gamma")
  call check("join", join(fields, " ") = "alpha beta gamma")

  # A whole program's worth of work that had nowhere to live before: read
  # lines, keep some, put them back together.
  var kept: text[] = []
  for i = 0 to count(fields) - 1
    if not text_eq(fields[i], "beta")
      kept = append(kept, fields[i])
    end
  end
  call check("filtering into a list", join(kept, ",") = "alpha,gamma")

  # --- an index that is out of range ------------------------------------
  # It fails loudly through the error slot rather than reading whatever
  # happens to sit after the array.
  let missing: int = numbers[99]
  call check("out of range reports an error", last_error_code() <> 0)
  call check("out of range yields the sentinel", missing = 0)

  # --- bytes -------------------------------------------------------------
  # Text is UTF-8, so its bytes are its encoding: "hé" is two characters and
  # three bytes, which is exactly the distinction a program handling a file
  # needs to make.
  let raw: bytes = bytes_from_text("hé")
  call check("bytes_count", bytes_count(raw) = 3)
  call check("length counts characters", length("hé") = 2)
  call check("a byte reads as a number", raw[0] = 104)
  call check("round trip", text_eq(text_from_bytes(raw), "hé"))

  # --- across subroutines, and at module level -------------------------
  call check("a subroutine returns an array", join(squares(4), ",") = "1,4,9,16")
  call check("a subroutine takes an array", total(squares(4)) = 30)
  log = append(log, "done")
  call check("a module-level array", count(log) = 1)

  var blob: bytes = bytes_new(2)
  blob[0] = 79
  blob[1] = 75
  call check("bytes_new and element assignment", text_eq(text_from_bytes(blob), "OK"))
end
