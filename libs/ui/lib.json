{
  "name": "ui",
  "comment": "Visual component library. Sources are split so the metadata TU never reaches a shipped program (ADR 0003/D12), and the UI stack links only into modules that actually declare a form.",
  "libinfo_sources": [
    "ui_libinfo.c"
  ],
  "impl_sources": [
    "ui_rmlui.cpp",
    "a11y_model.cpp",
    "a11y_accesskit.cpp"
  ],
  "cxx": true,
  "include_dirs": [
    "vendor/RmlUi/Include",
    "vendor/RmlUi/Backends",
    "vendor/accesskit-c/include"
  ],
  "extra_sources": [
    "vendor/RmlUi/Backends/RmlUi_Backend_SDL_GL3.cpp",
    "vendor/RmlUi/Backends/RmlUi_Platform_SDL.cpp",
    "vendor/RmlUi/Backends/RmlUi_Renderer_GL3.cpp"
  ],
  "defines": [
    "RMLUI_SDL_VERSION_MAJOR=2",
    "SDL_VIDEO_RENDER_OGL=1"
  ],
  "pkg_config": [
    "sdl2",
    "SDL2_image",
    "freetype2"
  ],
  "link_args": [
    "-Lvendor/RmlUi/build",
    "-lrmlui",
    "-lGL",
    "-ldl",
    "-lfreetype",
    "-Lvendor/accesskit-c/lib/linux/x86_64/static",
    "-laccesskit"
  ],
  "requires": [
    "vendor/RmlUi/build/librmlui.a",
    "vendor/accesskit-c/include/accesskit.h"
  ],
  "requires_hint": "RmlUi and/or accesskit-c are not vendored yet \u2014 run tools/fetch-rmlui.sh and tools/fetch-accesskit.sh"
}